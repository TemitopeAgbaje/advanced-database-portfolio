// Supalogi - Ride-hailing database design
// Paste this into https://dbdiagram.io to render the ER diagram.

Table cities {
  city_id      int [pk, increment]
  name         varchar [not null]
  country      varchar [not null]

  Note: 'Used later to split data by region (sharding).'
}

Table riders {
  rider_id     int [pk, increment]
  full_name    varchar [not null]
  email        varchar [not null, unique]
  phone        varchar [not null, unique]
  created_at   timestamp [default: `now()`]
}

Table drivers {
  driver_id    int [pk, increment]
  full_name    varchar [not null]
  email        varchar [not null, unique]
  phone        varchar [not null, unique]
  license_no   varchar [not null, unique]
  status       varchar [not null, default: 'offline'] // offline | available | on_trip
  created_at   timestamp [default: `now()`]
}

Table vehicles {
  vehicle_id   int [pk, increment]
  driver_id    int [not null, ref: > drivers.driver_id]
  plate_no     varchar [not null, unique]
  make         varchar [not null]
  model        varchar [not null]
  color        varchar
  year         int
}

Table trips {
  trip_id        int [pk, increment]
  rider_id       int [not null, ref: > riders.rider_id]
  driver_id      int [ref: > drivers.driver_id]      // null until a driver accepts
  city_id        int [not null, ref: > cities.city_id]
  pickup_addr    varchar [not null]
  dropoff_addr   varchar [not null]
  status         varchar [not null, default: 'requested'] // requested | accepted | ongoing | completed | cancelled
  fare           decimal(10,2)
  requested_at   timestamp [default: `now()`]
  started_at     timestamp
  ended_at       timestamp
}

Table payments {
  payment_id   int [pk, increment]
  trip_id      int [not null, unique, ref: - trips.trip_id] // one-to-one: one payment per trip
  amount       decimal(10,2) [not null]
  method       varchar [not null] // card | cash | wallet
  status       varchar [not null, default: 'pending'] // pending | paid | failed | refunded
  paid_at      timestamp
}

Table ratings {
  rating_id    int [pk, increment]
  trip_id      int [not null, ref: > trips.trip_id]
  from_role    varchar [not null] // rider | driver (who is giving the score)
  score        int [not null]     // 1 to 5
  comment      varchar
  created_at   timestamp [default: `now()`]

  Indexes {
    (trip_id, from_role) [unique] // each side rates a trip once
  }
}
